# Copy to `.env`. Never commit the real file (NFR-4: keys must not reach the
# frontend or land in run artifacts).

# Root of the subagent catalog the registry indexes. Defaults to the repo this
# project lives in, three levels up from packages/server.
# AGENT_OFFICE_REPO_ROOT=

# --- Phase 1: Claude Code provider (no key needed, uses your existing auth) ---
# Absolute path to the `claude` binary if it is not on PATH.
# CLAUDE_CLI_PATH=

# --- Phase 7: direct API providers. None are used before then. ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=

# --- Cost guardrails (NFR-5, FR-M8) ---
# AGENT_OFFICE_MAX_CONCURRENCY=3
# AGENT_OFFICE_ASSIGNMENT_TIMEOUT_MS=600000
# AGENT_OFFICE_RUN_TOKEN_BUDGET=1000000
