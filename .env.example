# Agent Office — API credentials and provider settings.
#
# Copy to `.env` and fill in what you have. `.env` is gitignored; this file is
# the committed template and must never contain a real key.
#
#   cp .env.example .env
#
# A real environment variable always beats a value in this file, so exporting a
# key for one command still works. Nothing here is required: the default
# provider is the local Claude Code CLI, which uses your existing sign-in
# (`claude auth login`) rather than a key.

# --- Anthropic ---------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- OpenAI ------------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com

# --- DeepSeek ----------------------------------------------------------------
# DeepSeek serves the OpenAI Chat Completions shape, so it runs through the same
# adapter with a different endpoint and key.
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Shared ------------------------------------------------------------------
# Cap on a single model response, applied to every HTTP provider.
# AGENT_OFFICE_MAX_OUTPUT_TOKENS=8192
