{
  "name": "agent-office",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Watch a team of subagents work: a manager distributes your task, specialists report back, you download the PDF.",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "registry:dump": "npm run registry:dump --workspace @agent-office/server",
    "run": "npm run run --workspace @agent-office/server --",
    "agent": "npm run agent --workspace @agent-office/server --",
    "serve": "npm run serve --workspace @agent-office/server --",
    "web": "npm run dev --workspace @agent-office/web",
    "build:web": "npm run build --workspace @agent-office/web",
    "test": "vitest run",
    "runs:purge": "npm run runs:purge --workspace @agent-office/server --",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
