{
  "name": "agent-office",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Watch a team of subagents work: a manager distributes your task, specialists report back, you download the PDF.",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "registry:dump": "npm run registry:dump --workspace @agent-office/server",
    "run": "npm run run --workspace @agent-office/server --",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
