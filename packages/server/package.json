{
  "name": "@agent-office/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Agent Office orchestrator host: agent registry, providers, run state.",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./src/index.ts",
    "./registry": "./src/registry/index.ts"
  },
  "scripts": {
    "registry:dump": "tsx src/scripts/dump.ts",
    "run": "tsx src/scripts/run.ts",
    "agent": "tsx src/scripts/agent.ts",
    "serve": "tsx src/scripts/serve.ts",
    "runs:purge": "tsx src/scripts/purge.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agent-office/shared": "*",
    "@fastify/websocket": "^11.0.1",
    "fastify": "^5.1.0",
    "marked": "^18.0.9",
    "yaml": "^2.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
